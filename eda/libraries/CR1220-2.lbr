<devicesets>
<deviceset name="CR1220-2" prefix="BT">
<description>Q&amp;J CR1220-2 SMD coin-cell holder, LCSC &lt;b&gt;C70381&lt;/b&gt;.
Machine-placeable replacement for the Keystone 2894, which JLCPCB do not stock.
Pad 1 = +, pad 2 = -, per EasyEDA's symbol for this part number.</description>
<gates>
<gate name="G$1" symbol="CR1220-2" x="0" y="0"/>
</gates>
<devices>
<device name="" package="BAT-SMD_CR1220-2">
<connects>
<connect gate="G$1" pin="+" pad="2"/>
<connect gate="G$1" pin="-" pad="1"/>
</connects>
