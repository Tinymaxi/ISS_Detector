<wire x1="9.32" y1="-7.45" x2="-10.44" y2="-7.45" width="0.127" layer="51"/>
<wire x1="-10.44" y1="-7.45" x2="-10.44" y2="7.45" width="0.127" layer="51"/>
<circle x="0" y="0" radius="6.25" width="0.127" layer="51"/>
<wire x1="-10.44" y1="7.45" x2="9.32" y2="7.45" width="0.2" layer="21"/>
